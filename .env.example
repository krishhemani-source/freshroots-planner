# Copy this file to .env and fill in what you need. Never commit .env.

# --- AI step (Gemini, free tier) ---
AI_MODE=mock                    # mock (default, no API calls) or live
GEMINI_API_KEY=
GEMINI_MODEL=                   # optional; overrides ai.model in config.yaml (e.g. gemini-3.8-flash)

# --- Database ---
# Empty = local SQLite file db/planner.db. For Neon: postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Zoho Inventory ---
ZOHO_MODE=mock                  # mock (default) or live; live creates DRAFT POs only
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_REGION=in                  # in = zoho.in (India data centre)

# --- Hosted (Vercel) only ---
DATA_SOURCE=files               # files (laptop: data/ folder) or db (Vercel: exports uploaded to the database)
APP_PASSCODE=                   # team passcode for the hosted site; empty = no sign-in (laptop)
CRON_SECRET=                    # Vercel Cron sends this; any long random string
DEPLOY_DATABASE_URL=            # laptop only: the Neon URL, for scripts/upload_exports.py and reset_demo.py --hosted
